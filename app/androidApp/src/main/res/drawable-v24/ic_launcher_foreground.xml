<?xml version="1.0" encoding="utf-8"?>
<!--
    Frente del ícono de la app: el logotipo de EYESOFTER Web (Views/Shared/_Logo.cshtml),
    un ojo con mira en el iris y líneas de "circuito" a los lados.

    Los trazos son los del SVG original (caja de 64 x 32). El <group> los escala
    a 0.95 y los centra en el lienzo de 108 x 108 de los íconos adaptables.
    Android recorta el ícono con distintas formas (círculo, cuadrado...), y solo
    se garantiza que se vea el círculo central de 66 dp: el ojo mide unos 57 dp
    de ancho, así que cabe completo en cualquier forma.

    Colores: trazos blancos y el iris en celeste ("eyes-celeste" de la web).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:translateX="23.6"
        android:translateY="38.8">
        <!-- Contorno del ojo -->
        <path
            android:pathData="M13,16c5,-7.5 11.5,-11 19,-11s14,3.5 19,11c-5,7.5 -11.5,11 -19,11S18,23.5 13,16z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Iris (radio 6.5) -->
        <path
            android:pathData="M25.5,16a6.5,6.5 0,1 0,13 0a6.5,6.5 0,1 0,-13 0z"
            android:strokeColor="#9FC0F2"
            android:strokeWidth="2" />
        <!-- Pupila (radio 2.4) -->
        <path
            android:pathData="M29.6,16a2.4,2.4 0,1 0,4.8 0a2.4,2.4 0,1 0,-4.8 0z"
            android:fillColor="#FFFFFF" />
        <!-- Mira y líneas de circuito -->
        <path
            android:pathData="M32,7.5v3M32,21.5v3M23.5,16h3M37.5,16h3M13,16H8l-3.5,-4M13,16H8l-3.5,4M51,16h5l3.5,-4M51,16h5l3.5,4"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Terminales de los circuitos -->
        <path
            android:pathData="M2.3,11a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0zM2.3,21a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0zM59.1,11a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0zM59.1,21a1.3,1.3 0,1 0,2.6 0a1.3,1.3 0,1 0,-2.6 0z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
